# Node dependencies
node_modules/
package-lock.json
npm-debug.log*

# Git ignore python scripts except agent.py
*.py
!agent.py
*.pyc
__pycache__/

# Pre-compiled agent binaries (distributed via GitHub Actions Releases)
public/tanz-agent*

# Sensitive / volatile runtime data
data/*.json
!data/servers.example.json
!data/ping_targets.json
!data/province_nodes.json

# Logs & temp files
*.log
*.tmp
*.pid
.env
.DS_Store
server.js.bak
server.js.backup*
